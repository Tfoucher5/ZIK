# Copie ce fichier en .env et remplis tes clés Supabase. En local : toujours le
# projet de staging ZIK-DEV, jamais la prod.
# Supabase Dashboard → projet ZIK-DEV → Settings → API

SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Clé service_role (même page) : écritures du serveur (scores, admin, cartes)
SUPABASE_SERVICE_KEY=

# Protège les routes appelées par les workflows GitHub (en-tête x-admin-key).
# Une valeur différente par environnement, ex. `openssl rand -hex 32`
ADMIN_SECRET=

# Notifications push. Une paire par environnement : `npx web-push generate-vapid-keys`
# Vide = push désactivées.
PUBLIC_VAPID_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:theo@zik-music.fr

# Anti-robot Cloudflare Turnstile (inscription, connexion, mot de passe oublié).
# Clé de site publique ; la clé secrète se renseigne dans Supabase :
# Authentication > Attack Protection > Captcha. Vide = pas de vérification.
# Hors prod : clé de test Cloudflare 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=

# E-mails envoyés par le site (confirmation d'achat ZIK Pro) via Resend.
# resend.com > API Keys > Create (Sending access, domaine zik-music.fr).
# Vide = aucun mail envoyé, l'achat fonctionne quand même. Hors prod : vide.
RESEND_API_KEY=
# Adresse qui reçoit les alertes « nouvelle vente ZIK Pro » (défaut : theo@zik-music.fr)
ADMIN_EMAIL=

# Paiement ZIK Pro. Clés sk_test_ en local, sk_live_ en prod.
# Stripe Dashboard > Développeurs > Clés API
STRIPE_SECRET_KEY=
# Local : affiché par `stripe listen --forward-to localhost:5173/api/stripe/webhook`
# Prod : Développeurs > Webhooks > endpoint https://www.zik-music.fr/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Catalogue de produits > prix de chaque formule (price_...)
STRIPE_PRICE_NIGHT=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Spotify — developer.spotify.com → Create app → Client ID + Client Secret
# Nécessaire pour importer des playlists Spotify et rechercher des titres
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

PORT=3000

# Prospection ZIK Pro (scripts/prospection) : mot de passe de la boîte IONOS
# theo@zik-music.fr, utilisé pour envoyer (SMTP) et lire les réponses (IMAP).
PROSPECT_MAIL_PASSWORD=

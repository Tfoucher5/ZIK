# Copie ce fichier en .env et remplis tes clés Supabase
# Supabase Dashboard → Settings → API

SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anti-robot Cloudflare Turnstile (inscription, connexion, mot de passe oublié).
# Clé de site publique ; la clé secrète se renseigne dans Supabase :
# Authentication > Attack Protection > Captcha. Vide = pas de vérification.
PUBLIC_TURNSTILE_SITE_KEY=

# E-mails envoyés par le site (confirmation d'achat ZIK Pro) via Resend.
# resend.com > API Keys > Create (Sending access, domaine zik-music.fr).
# Vide = aucun mail envoyé, l'achat fonctionne quand même.
RESEND_API_KEY=
# Adresse qui reçoit les alertes « nouvelle vente ZIK Pro » (défaut : theo@zik-music.fr)
ADMIN_EMAIL=

# Paiement ZIK Pro. Clés sk_test_ en local, sk_live_ en prod.
# Stripe Dashboard > Développeurs > Clés API
STRIPE_SECRET_KEY=
# Local : affiché par `stripe listen --forward-to localhost:5173/api/stripe/webhook`
# Prod : Développeurs > Webhooks > endpoint https://www.zik-music.fr/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Catalogue de produits > prix de chaque formule (price_...)
STRIPE_PRICE_NIGHT=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Spotify — developer.spotify.com → Create app → Client ID + Client Secret
# Nécessaire pour importer des playlists Spotify et rechercher des titres
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

PORT=3000
